# Each provider is on only when both of its keys are set
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where links in emails point, which with Docker is the address Caddy answers on
PUBLIC_URL=
INSTANCE_NAME=Hearth
INSTANCE_LOGO=
INSTANCE_ICON=
# false keeps search engines out
INSTANCE_INDEXING=true

# MAIL_PROVIDER is smtp, zeptomail, postmark, mailgun, sendgrid, brevo or ses
# Providers other than smtp take their own keys such as ZEPTOMAIL_API_KEY
# SMTP_TLS=ssl is implicit TLS on port 465, otherwise STARTTLS when offered
MAIL_PROVIDER=smtp
MAIL_FROM=
MAIL_FROM_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=

# Web push is off unless both keys are set
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# STORAGE is local, a folder served by the API at /storage, or s3
STORAGE=local
STORAGE_PATH=
API_URL=http://localhost:4000
# For STORAGE=s3, any S3 compatible store
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PATH_STYLE=false
S3_CHECKSUMS=true

UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=25
UPLOAD_MAX_ATTACHMENTS=10
UPLOAD_MAX_VIDEO_MB=100
UPLOAD_MAX_VIDEO_MINUTES=20
IMAGE_AVIF=false

# Screening holds unsafe looking content for a person to decide
#   local   open models on this server's ai nodes, about 2 GB to download and 4 GB of memory
#   hosted  a model behind OpenRouter, which is sent what is checked
#   off     no screening, reports still reach each community's queue
MODERATION_SCREENER=local
MODERATION_THRESHOLD=0.5
# images screens every image on the instance whatever each community picked
IMAGE_SCREENING_FLOOR=off
MODERATION_TEXT_MODEL=Qwen/Qwen3Guard-Gen-0.6B
MODERATION_IMAGE_MODEL=Falconsai/nsfw_image_detection
# An OpenRouter model id, for the hosted screener only
MODERATION_HOSTED_MODEL=google/gemini-2.5-flash
OPENROUTER_API_KEY=

# Transcripts of recorded voice rooms and live captions in them
#   off     no transcripts and no captions
#   local   Whisper on this server's ai nodes
TRANSCRIPTION=off
# How many stretches of speech a node turns into live captions at once. More are skipped
# rather than queued, so captions can drop a line but never slow the room. Raise it on a GPU
CAPTION_LIMIT=2

# An EC P-256 private key in PEM form
#   openssl ecparam -name prime256v1 -genkey -noout | openssl pkcs8 -topk8 -nocrypt
# When replacing it, keep the old public key in JWT_PREVIOUS_PUBLIC_KEYS until its tokens run out
JWT_PRIVATE_KEY=
JWT_PREVIOUS_PUBLIC_KEYS=

# json or text
LOG_FORMAT=json
# Traces go to this OTLP collector when set
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=hearth

# Serves the API docs at /docs and /redoc
API_DOCS=false

# With Docker, Caddy gets a certificate for PUBLIC_HOST, the host name in PUBLIC_URL
# ACME_EMAIL hears about it
# HTTP_PORT and HTTPS_PORT move Caddy off 80 and 443
PUBLIC_HOST=localhost
ACME_EMAIL=
HTTP_PORT=80
HTTPS_PORT=443
# The database password compose gives Postgres and the API
POSTGRES_PASSWORD=
# Make one with mix phx.gen.secret or openssl rand -base64 48
SECRET_KEY_BASE=

# The relay starts with docker compose --profile voice
# TURN_SECRET signs short lived relay logins
# TURN_URL is the relay's host, or full turn and turns URLs comma separated
# RTC_PUBLIC_IP is the address browsers reach, and voice stays hidden while it is blank
TURN_SECRET=
TURN_URL=
RTC_PUBLIC_IP=
# UDP ports open to browsers on every rtc node
RTC_PORT_RANGE=50000-50199
VOICE_ROOM_LIMIT=50

# Comma separated from web, rtc, media and ai, where blank runs everything but rtc
# Nodes without web answer /healthz on METRICS_PORT instead of the API
HEARTH_ROLES=

# Metrics are served on their own port, with basic auth when both credentials are set
METRICS_PORT=9568
METRICS_USERNAME=
METRICS_PASSWORD=
# Dashboards are uploaded at boot when the host is set with a token, or a username and password
# For the local Grafana from infra/compose.observe.yml use http://localhost:3000 with admin and admin
GRAFANA_HOST=
GRAFANA_TOKEN=
GRAFANA_USERNAME=
GRAFANA_PASSWORD=

# Encrypts chat messages at rest, 32 bytes in base64 from `openssl rand -base64 32`
# Production won't start without it and losing it loses every message
# When you change it, put the old key in ENCRYPTION_PREVIOUS_KEYS
ENCRYPTION_KEY=
ENCRYPTION_PREVIOUS_KEYS=
# Hashes sealed values for lookup, made the same way and required in production
# Never change it with ENCRYPTION_KEY or lookups stop matching
ENCRYPTION_HASH_KEY=

# Reads secrets from Vault when SECRETS_FILE is set, and boot stops if one is missing
# infra/compose.vault.yml sets these for Compose, see infra/k8s/README.md
SECRETS_FILE=
SECRETS_ENV=
VAULT_ADDR=
# kubernetes, approle (VAULT_ROLE_ID_FILE and VAULT_SECRET_ID_FILE) or token (VAULT_TOKEN)
VAULT_AUTH=
VAULT_ROLE=
VAULT_ROLE_ID_FILE=
VAULT_SECRET_ID_FILE=
VAULT_TOKEN=

# The account that owns the sample communities from make seed, for local testing only
SEED_OWNER=
