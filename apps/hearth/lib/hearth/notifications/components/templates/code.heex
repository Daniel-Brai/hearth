<mj-text align="center" padding="8px 0 24px">
  <div
    class="code-box"
    style="display: inline-block; padding: 14px 10px 14px 20px; border-radius: 12px; background: #f4f4f2; font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: 30px; font-weight: 900; letter-spacing: 0.35em;"
  >
    {render_slot(@inner_block)}
  </div>
</mj-text>
