<mjml>
  <mj-head>
    <mj-title>{@title}</mj-title>
    <mj-preview :if={@preview}>{@preview}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif" />
      <mj-text color="#1d2433" font-size="16px" line-height="1.5" padding="0 0 16px" />
    </mj-attributes>
    <mj-style phx-no-curly-interpolation>
      @media (max-width: 480px) {
      .card > table > tbody > tr > td { padding: 28px 20px 12px !important; }
      }
      @media (prefers-color-scheme: dark) {
      body, .page, .page > table { background: #0f1620 !important; }
      .card > table, .card td { background: #1a2330 !important; }
      .card div, .brand div, .brand a { color: #f3f4f6 !important; }
      .code-box { background: #243040 !important; }
      .digest-item a, .digest-more a { color: #f3f4f6 !important; }
      .card a.link { color: #9cc3ff !important; }
      .digest-heading a, .digest-item span { color: #9ca3af !important; }
      .button td, .button a { background: #f3f4f6 !important; color: #1d2433 !important; }
      .divider p { border-color: #2c3747 !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f4f4f2" width="560px" css-class="page">
    <mj-section padding="32px 16px 24px">
      <mj-column>
        <mj-image
          src={@icon}
          alt=""
          href={@url}
          width="44px"
          height="44px"
          border-radius="12px"
          padding="0 0 12px"
        />
        <mj-text align="center" font-size="22px" font-weight="900" padding="0" css-class="brand">
          <a href={@url} style="color: #1d2433; text-decoration: none;">{@brand}</a>
        </mj-text>
      </mj-column>
    </mj-section>
    <mj-section
      background-color="#ffffff"
      border-radius="16px"
      padding="40px 40px 24px"
      css-class="card"
    >
      <mj-column>
        {render_slot(@inner_block)}
      </mj-column>
    </mj-section>
    <mj-section padding="24px 24px 32px">
      <mj-column>
        {render_slot(@footer)}
        <mj-text :if={@host} align="center" color="#6b7280" font-size="13px" padding="0">
          {URI.parse(@url).host}
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
