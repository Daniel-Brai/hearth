# Where the data comes from. "mock" runs the in-memory gateway with seed data; leave unset to use the API.
VITE_HEARTH_DATA=
# The Phoenix API origin, used when VITE_HEARTH_DATA is not "mock".
VITE_API_URL=http://localhost:4000
# With the in-memory data, "off" shows the app as an instance without transcripts or
# live captions. The API reports its own TRANSCRIPTION setting instead.
VITE_TRANSCRIPTION=
